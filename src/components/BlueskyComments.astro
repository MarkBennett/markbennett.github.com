---
interface Props {
  postUrl: string;
}

const { postUrl } = Astro.props;

// Convert Bluesky web URL to AT URI
function webUrlToAtUri(url: string): string | null {
  try {
    const urlObj = new URL(url);
    const pathParts = urlObj.pathname.split('/').filter(p => p);
    
    // Expected format: /profile/{handle}/post/{postId}
    if (pathParts.length !== 4 || pathParts[0] !== 'profile' || pathParts[2] !== 'post') {
      return null;
    }
    
    const handle = pathParts[1];
    const postId = pathParts[3];
    
    return `at://${handle}/app.bsky.feed.post/${postId}`;
  } catch (e) {
    return null;
  }
}

const atUri = webUrlToAtUri(postUrl);
let thread = null;
let error = false;

if (atUri) {
  try {
    const apiUrl = `https://public.api.bsky.app/xrpc/app.bsky.feed.getPostThread?uri=${encodeURIComponent(atUri)}`;
    const response = await fetch(apiUrl);
    
    if (response.ok) {
      const data = await response.json();
      thread = data.thread;
    } else {
      error = true;
    }
  } catch (e) {
    error = true;
  }
} else {
  error = true;
}

const replies = thread?.replies || [];
---

<div class="mt-12 pt-8 border-t border-gray-300">
  <h2 class="text-2xl font-bold mb-6 text-heading">Comments</h2>
  
  {error ? (
    <div class="mb-6">
      <p class="text-muted mb-4">Comments are hosted on Bluesky.</p>
      <a 
        href={postUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors"
      >
        View conversation on Bluesky →
      </a>
    </div>
  ) : (
    <>
      <div class="mb-6">
        <button
          id="reply-button"
          data-url={postUrl}
          class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors cursor-pointer"
        >
          Reply on Bluesky
        </button>
      </div>

      {replies.length === 0 ? (
        <p class="text-muted">No comments yet. Be the first to reply on Bluesky!</p>
      ) : (
        <div class="space-y-6">
          {replies.map((reply: any) => {
            const author = reply.post?.author;
            const record = reply.post?.record;
            
            if (!author || !record) return null;
            
            return (
              <div class="border border-gray-200 rounded-lg p-4 bg-white">
                <div class="flex items-start gap-3 mb-3">
                  {author.avatar && (
                    <img 
                      src={author.avatar} 
                      alt={author.displayName || author.handle}
                      class="w-10 h-10 rounded-full"
                    />
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="font-semibold text-heading">
                      {author.displayName || author.handle}
                    </div>
                    <div class="text-sm text-muted">
                      @{author.handle}
                    </div>
                  </div>
                </div>
                <div class="prose prose-sm max-w-none">
                  <p class="whitespace-pre-wrap">{record.text}</p>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </>
  )}
</div>

<script>
  // Handle Reply button click with centered popup
  const replyButton = document.getElementById('reply-button');
  
  if (replyButton) {
    replyButton.addEventListener('click', () => {
      const url = replyButton.getAttribute('data-url');
      if (!url) return;
      
      // Calculate centered position
      const width = 600;
      const height = 700;
      const left = (window.screen.width - width) / 2;
      const top = (window.screen.height - height) / 2;
      
      // Try to open centered popup
      const popup = window.open(
        url,
        'bluesky-reply',
        `width=${width},height=${height},left=${left},top=${top},popup=yes,noopener=yes,noreferrer=yes`
      );
      
      // Fallback: if popup blocked, open in new tab
      if (!popup || popup.closed || typeof popup.closed === 'undefined') {
        window.open(url, '_blank', 'noopener,noreferrer');
      }
    });
  }
</script>
