---
import {
  SiBluesky,
  SiFacebook,
  SiGithub,
  SiInstagram,
  SiMastodon
} from "react-icons/si";
import { MastodonShare } from "../components/mastodon/MastodonShare";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "MarkBennett.ca - The who, what, where" } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-800 p-5">
    <div class="max-w-7xl mx-auto">
      <header class="mb-8">
        <a
          href="/"
          class="no-underline text-inherit flex justify-start gap-4 items-center"
        >
          <img
            src="/images/profile-2026.jpg"
            alt="An image of me peeking up from the bottom of the frame"
            class="w-24 h-24 rounded-full object-cover mb-4"
          />
          <div>
            <h2 class="text-4xl mb-2 text-heading font-bold">MarkBennett.ca</h2>
            <p class="text-muted text-lg">The who, what, where</p>
          </div>
        </a>
        <hr class="border-0 border-t-2 border-border my-6" />
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <main class="md:col-span-2">
          <slot />

          <div class="mt-8 pt-6 border-t-2 border-border">
            <p class="text-muted text-sm mb-3">Share this page on:</p>
            <div class="flex gap-4">
              <a
                href={`https://bsky.app/intent/compose?text=${encodeURIComponent(Astro.url.href)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:text-primary-dark transition-colors flex items-center gap-2"
                aria-label="Share on Bluesky"
              >
                <SiBluesky className="w-5 h-5" />
                <span class="hidden md:inline">Bluesky</span>
              </a>
              <MastodonShare url={Astro.url.href} client:idle>
                <div
                  class="text-primary hover:text-primary-dark transition-colors flex items-center gap-2"
                >
                  <SiMastodon className="w-5 h-5" />
                  <span class="hidden md:inline">Mastodon</span>
                </div>
              </MastodonShare>
            </div>
          </div>
        </main>

        <aside class="space-y-8">
          <section>
            <h4 class="text-xl mb-4 text-heading font-semibold">About Me</h4>
            <p class="mb-4">
              I'm a dad, programmer, and runner. Aspiring swimmer and French
              speaker.
            </p>
            <p class="mb-4">
              I live in Edmonton, Canada and am married to Matthew Woodley.
            </p>
            <p class="mb-4">🏳️‍🌈🧑🏻‍💻🏃🏻🍁</p>

            <section>
              <h4 class="text-xl mb-4 text-heading font-semibold">
                Let's Connect
              </h4>
              <div class="flex gap-4 mb-4">
                <a
                  href="https://github.com/MarkBennett"
                  class="text-primary hover:text-primary-dark transition-colors"
                  aria-label="GitHub"
                >
                  <SiGithub className="w-6 h-6" />
                </a>
                <a
                  href="https://bsky.app/profile/markbennett.ca"
                  class="text-primary hover:text-primary-dark transition-colors"
                  aria-label="Bluesky"
                >
                  <SiBluesky className="w-6 h-6" />
                </a>
                <a
                  href="https://www.instagram.com/markbennett.ca?igsh=MXRtdGVpaTg2dnRlYg=="
                  class="text-primary hover:text-primary-dark transition-colors"
                  aria-label="Instagram"
                >
                  <SiInstagram className="w-6 h-6" />
                </a>
                <a
                  rel="me"
                  href="https://mastodon.social/@markbennett"
                  class="text-primary hover:text-primary-dark transition-colors"
                  aria-label="Mastodon"
                >
                  <SiMastodon className="w-6 h-6" />
                </a>
                <a
                  href="http://www.facebook.com/mark.f.bennett"
                  class="text-primary hover:text-primary-dark transition-colors"
                  aria-label="Facebook"
                >
                  <SiFacebook className="w-6 h-6" />
                </a>
              </div>
            </section>
          </section>
        </aside>
      </div>
    </div>
  </body>
</html>
