---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog');
const sortedPosts = allBlogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get all projects and talks
const allProjects = await getCollection('project');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Format date helper
function formatDate(date: Date): string {
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="markbennett.ca">
    <h4>Projects & Talks</h4>
    <ul>
        {sortedProjects.map((project) => (
            <li><a href={project.data.url}><strong>{project.data.title}</strong>, <em>{project.data.description}</em></a></li>
        ))}
    </ul>

    <h4>Recent Blog Posts</h4>
    <ul class="blog-list">
        {sortedPosts.map((post) => (
            <li>
                <a href={`/blog/${post.slug}/`}><strong>{post.data.title}</strong></a>
                <div class="blog-meta">{formatDate(post.data.pubDate)}</div>
                {post.data.description && <p><em>{post.data.description}</em></p>}
            </li>
        ))}
    </ul>
</Layout>
